# ==========================================
# Air Quality Intelligence Agent Environment Config
# ==========================================

# Optional: LLM Brain API Keys
# If left blank, the application will automatically use the built-in Deterministic ReAct Engine (Zero API Keys required!).
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: Custom OpenAI-Compatible Base URL (e.g. Groq, Ollama, vLLM, LMStudio)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Optional: External Air Quality API Keys
# Note: Open-Meteo Air Quality & Weather APIs are used by default with global coverage and 0 API keys required.
# WAQI_API_TOKEN=your_waqi_api_token_here
